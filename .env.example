# 复制为 .env 后填真实值；.env 已被 gitignore，禁止提交

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_app
DB_USERNAME=ai_app
DB_PASSWORD=change_me

# JWT 密钥（≥32 字节）
JWT_SECRET=change_me_to_a_long_random_secret

# 模型服务：阿里云百炼 DashScope（OpenAI 兼容）
# 备用：Ollama http://127.0.0.1:11434
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxx
AI_CHAT_MODEL=qwen-plus
AI_VL_MODEL=qwen-vl-ocr-2025-11-20
AI_EMBEDDING_MODEL=text-embedding-v3

# 加密密钥（32 字节 base64）
APP_CRYPTO_KEY=change_me

# 上传目录
APP_UPLOAD_DIR=./uploads
