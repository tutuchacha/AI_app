# 复制为 ops/.env 后填真实值：cp ops/.env.example ops/.env
# ops/.env 已在 .gitignore 中，不会提交到仓库

# ---- PostgreSQL（pgvector/pgvector:pg16）----
DB_NAME=ai_app
DB_USERNAME=ai_app
DB_PASSWORD=改成强密码

# ---- 应用 ----
# 至少 32 字节随机串，可用 openssl rand -base64 48 生成
JWT_SECRET=改成至少32字节的随机串
DASHSCOPE_API_KEY=sk-xxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_CHAT_MODEL=qwen-plus
CHAT_RATE_LIMIT=20
AI_TIMEOUT=60s

# ---- 对外端口（只暴露 Nginx）----
WEB_PORT=80

# ---- 监控：docker compose --profile monitoring up -d 才启动 ----
# 默认只绑本机，外网访问用 ssh -L 3000:127.0.0.1:3000 user@服务器
MONITOR_BIND=127.0.0.1
GRAFANA_PASSWORD=改成强密码

# ---- VM 部署（docker-compose.vm.yml）----
# 后端跑在 Windows/其他机器时填它的 IP，容器里的 host.docker.internal 会指过去；
# 后端也在同一台机器上跑就保持 host-gateway
BACKEND_HOST=host-gateway
